{
  "name": "wangung-hanaro-shift-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "app": "node --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local scripts/app.js",
    "test": "node --test server/*.test.js",
    "dev": "vite",
    "server": "node --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local server/index.js",
    "start": "node --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local server/index.js",
    "db:migrate": "node --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local scripts/migrate-neon.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@vercel/functions": "^3.9.11",
    "antd": "^6.6.5",
    "better-sqlite3": "^12.2.0",
    "date-holidays": "^3.37.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "glpk.js": "^5.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
